# Copy to .env and fill in. Never commit .env.
# Captioner / attribute extractor (required for caption and extract stations)
ANTHROPIC_API_KEY=
# Default generator and second captioner (key from https://aistudio.google.com)
GEMINI_API_KEY=
# Gemini is billed at list price unless you set this to 1. Only do that if your key really is on
# the free tier; then Gemini calls are costed at 0 and only the list price is recorded.
GEMINI_FREE_TIER=0
# Free seeded generator (Cloudflare Workers AI, FLUX.1 schnell)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional paid providers
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
# Hard stop on lifetime API spend for the project, in USD. Counted from the ledger's spend log,
# so it survives restarts; a call that would go over it is refused before it is made.
TELEPHONE_SPEND_CAP_USD=15
# Where runs, cache, results and the ledger live
TELEPHONE_DATA_DIR=data
# Enable the /live endpoint of the API (off by default so the public site never spends money)
TELEPHONE_LIVE=0
TELEPHONE_LIVE_DAILY_CAP_USD=1
