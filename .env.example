# Copy to .env and fill in. Never commit .env.
# Captioner / attribute extractor (required for caption and extract stations)
ANTHROPIC_API_KEY=
# Default generator and second captioner (free tier at https://aistudio.google.com)
GEMINI_API_KEY=
# Free seeded generator (Cloudflare Workers AI, FLUX.1 schnell)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional paid providers
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
# Hard stop on spend for a single process, in USD
TELEPHONE_SPEND_CAP_USD=20
# Where runs, cache and ledger live
TELEPHONE_DATA_DIR=data
# Enable the /live endpoint of the API (off by default so the public site never spends money)
TELEPHONE_LIVE=0
TELEPHONE_LIVE_DAILY_CAP_USD=1
